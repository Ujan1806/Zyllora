# Root .gitignore for Zyllora

# OS Files
.DS_Store
Thumbs.db

# Environment and Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env

# Dependencies
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
env/
ENV/
.venv/

# Build and Distribution
dist/
dist-ssr/
build/
*.egg-info/
.eggs/

# IDE & Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Testing and Coverage
coverage/
.coverage
htmlcov/
.pytest_cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Supabase Local
.supabase/
