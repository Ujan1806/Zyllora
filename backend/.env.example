# ==============================================================================
# Zyllora Backend Environment Variables
# ==============================================================================

# Application Configuration
PROJECT_NAME="Zyllora API"
API_V1_PREFIX="/api/v1"
DEBUG=true
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Supabase Credentials (from your Supabase Project Settings > API)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Supabase JWT Secret (from Supabase Project Settings > API > JWT Settings > JWT Secret)
# Used to verify user access tokens securely on the backend
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-optional"
STORAGE_BUCKET="documents"

# Document Upload & Processing Limits
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=200
PROCESSING_TIMEOUT_SECONDS=300

# Chunking Configuration
CHUNK_TARGET_WORDS=600
CHUNK_OVERLAP_WORDS=80

# AI Provider Configuration (Options: "gemini" [Free tier recommended], "openai", "groq", "mock")
AI_PROVIDER="gemini"

# Google Gemini API (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"

# Optional: OpenAI / Groq Compatible Alternative
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Embedding Provider (Options: "gemini", "openai", "mock")
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSIONS=768

# RAG Engine Settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_MESSAGES=6
RAG_MAX_USER_MESSAGE_LENGTH=2500

# Logging
LOG_LEVEL="INFO"
