# ==============================================================================
# Zyllora Frontend Environment Variables
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Supabase Public Configuration (from Supabase Dashboard > Settings > API)
# NOTE: ONLY use the anon public key here. NEVER put the service-role key in frontend!
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional: Google OAuth Client ID if enabling Google sign-in
VITE_GOOGLE_AUTH_ENABLED="false"
